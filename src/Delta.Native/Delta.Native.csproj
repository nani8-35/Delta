<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <DefineConstants Condition="'$(DeltaDiagnostics)'=='true'">$(DefineConstants);DELTA_DIAGNOSTICS</DefineConstants>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Delta</AssemblyName>
    <Version>2.1.11</Version>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <Resource Include="Assets\icon.ico" />
    <Content Include="Assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\chat-bridge.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>










